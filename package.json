{
  "name": "locale-lint",
  "version": "2.0.0",
  "description": "Zero-config i18n linter for React Native, React & Next.js — cross-references your code against locale files to catch missing, unused, undefined keys and hardcoded strings. Runs in CI, no ESLint setup.",
  "main": "dist/cli.js",
  "bin": {
    "locale-lint": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "AGENTS.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build",
    "dev": "ts-node src/cli.ts",
    "check": "ts-node src/cli.ts check",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "ts-node src/cli.ts check --src example/src --locales example/locales"
  },
  "keywords": [
    "i18n",
    "internationalization",
    "localization",
    "lint",
    "linter",
    "i18n-lint",
    "translation",
    "cli",
    "react",
    "react-native",
    "nextjs",
    "next-intl",
    "i18next",
    "react-intl",
    "formatjs",
    "vue-i18n",
    "missing-keys",
    "unused-keys",
    "hardcoded-strings"
  ],
  "author": "francisojeah",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/francisojeah/locale-lint"
  },
  "homepage": "https://github.com/francisojeah/locale-lint#readme",
  "bugs": {
    "url": "https://github.com/francisojeah/locale-lint/issues"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@babel/parser": "^7.23.0",
    "@babel/traverse": "^7.23.0",
    "@babel/types": "^7.23.0",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "glob": "^10.3.10",
    "minimatch": "^9.0.5"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.4",
    "@types/node": "^20.10.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2",
    "vitest": "^2.1.8"
  }
}
